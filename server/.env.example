# ==========================================
# CompanyBrain Environment Configuration
# ==========================================

PORT=5000
NODE_ENV=development

# Authentication
JWT_SECRET=companybrain_super_secure_jwt_secret_key_2026_enterprise

# Supabase Database Configuration (Optional - falls back to local persistent store if empty)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# External RAG / LLM Provider Configuration
# Set your OpenAI / Anthropic / Gemini / vLLM endpoint and API key here.
# For local testing, if blank, CompanyBrain activates its intelligent built-in RAG synthesis engine.
RAG_API_URL=https://api.openai.com/v1/chat/completions
RAG_API_KEY=
RAG_MODEL=gpt-4o-mini
